{
  "name": "Enterprise Lead Triage & Autonomous AI Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-webhook",
        "responseMode": "onReceived"
      },
      "name": "Incoming Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "options": {
          "temperature": 0.2
        }
      },
      "name": "Claude Agent Reasoning",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [350, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO qualified_leads (email, score, intent, created_at) VALUES ($1, $2, $3, NOW());"
      },
      "name": "PostgreSQL Ingestion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [600, 300]
    }
  ],
  "connections": {
    "Incoming Webhook": {
      "main": [[{"node": "Claude Agent Reasoning", "type": "main", "index": 0}]]
    },
    "Claude Agent Reasoning": {
      "main": [[{"node": "PostgreSQL Ingestion", "type": "main", "index": 0}]]
    }
  }
}
